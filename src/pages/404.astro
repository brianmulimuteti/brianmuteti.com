---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead
      title="Page not found"
      description="There is no page at this address."
    />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <Header />
    <main id="main">
      <p class="eyebrow">404 · Page not found</p>
      <h1>Nothing lives at this address.</h1>
      <p class="lede">
        The link may be out of date, or the address mistyped. Either way,
        this is the one error on the site that is working as intended.
      </p>

      <hr class="rule" />

      <p>
        Try the <a href="/">homepage</a>, the <a href="/work">case studies</a>,
        or the <a href="/about">about page</a>.
      </p>
    </main>
    <Footer />
  </body>
</html>

<style>
  .lede {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--muted);
    margin-bottom: var(--space-6);
  }
</style>
