---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'work'>['data'] & {
  readingMinutes: number;
  next?: { id: string; title: string };
};

const { title, subtitle, role, context, stack, summary, readingMinutes, next } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={summary} />
  </head>
  <body>
    <Header />
    <main id="main">
      <article>
        <p class="eyebrow">Selected work · {context}</p>
        <h1>{title}</h1>
        <p class="subtitle">{subtitle}</p>

        <div class="meta">
          <div><span>Role</span><p>{role}</p></div>
          <div><span>Stack</span><p>{stack.join(' · ')}</p></div>
          <div><span>Reading time</span><p>{readingMinutes} min</p></div>
        </div>

        <hr class="rule" />

        <div class="content">
          <slot />
        </div>

        <hr class="rule" />

        <nav class="pager" aria-label="More case studies">
          <a class="back" href="/work"><span aria-hidden="true">←</span> All work</a>
          {next && (
            <a class="next" href={`/work/${next.id}`}>
              <span class="next-label">Next case study</span>
              <span class="next-title">{next.title} <span aria-hidden="true">→</span></span>
            </a>
          )}
        </nav>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .subtitle {
    font-family: var(--serif);
    font-size: 1.2rem;
    color: var(--muted);
    line-height: 1.4;
    margin-bottom: var(--space-8);
  }
  .meta {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: var(--space-6);
    margin-top: var(--space-6);
    font-size: 0.9rem;
  }
  .meta span {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    display: block;
    margin-bottom: var(--space-1);
  }
  .meta p { margin: 0; color: var(--text); }
  .pager {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }
  .pager a { text-decoration: none; }
  .back { color: var(--muted); }
  .back:hover { color: var(--accent); }
  .next {
    margin-left: auto;
    max-width: 24rem;
    text-align: right;
  }
  .next-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: var(--space-1);
  }
  .next-title {
    display: block;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--text);
    text-wrap: balance;
    transition: color 0.15s ease;
  }
  .next:hover .next-title { color: var(--accent); }

  @media (max-width: 500px) {
    .meta { grid-template-columns: 1fr; gap: var(--space-3); }
    .next { margin-left: 0; text-align: left; }
  }
</style>